flowchart TB
  subgraph ns["Namespace: kafka-migration"]
    subgraph zk["StatefulSet: zookeeper (3 replicas)"]
      zk0["zookeeper-0"]
      zk1["zookeeper-1"]
      zk2["zookeeper-2"]
    end

    subgraph brokers["StatefulSet: kafka (3 replicas)"]
      b0["kafka-0"]
      b1["kafka-1"]
      b2["kafka-2"]
    end

    subgraph controllers["StatefulSet: kraft-controller (3 replicas)"]
      c0["kraft-controller-0"]
      c1["kraft-controller-1"]
      c2["kraft-controller-2"]
    end

    bootstrap["Service: kafka-bootstrap"]
    zkHeadless["Headless Service: zookeeper-headless"]
    kafkaHeadless["Headless Service: kafka-headless"]
    controllerHeadless["Headless Service: kraft-controller-headless"]
  end

  bootstrap --> brokers
  kafkaHeadless --> brokers
  zkHeadless --> zk
  controllerHeadless --> controllers
  brokers -. "ZooKeeper mode before finalization" .-> zk
  controllers -. "metadata migration" .-> zk
  brokers --> controllers

