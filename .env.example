COMPOSE_PROJECT_NAME=kafka-zk-kraft
KAFKA_IMAGE=confluentinc/cp-kafka:7.7.1
ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.7.1

KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw
ZOOKEEPER_CONNECT=zookeeper-1:2181,zookeeper-2:2181,zookeeper-3:2181/kafka
CONTROLLER_QUORUM_VOTERS=101@kraft-controller-1:9093,102@kraft-controller-2:9093,103@kraft-controller-3:9093

KAFKA_MIN_INSYNC_REPLICAS=2
KAFKA_DEFAULT_REPLICATION_FACTOR=3
KAFKA_DEFAULT_PARTITIONS=6
KAFKA_RETENTION_HOURS=168

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

